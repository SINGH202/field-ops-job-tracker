{
  "name": "field-ops-job-tracker",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "migrate": "npm run migrate -w @field-ops/api",
    "seed": "npm run seed -w @field-ops/api",
    "dev:api": "npm run dev -w @field-ops/api",
    "dev:web": "npm run dev -w @field-ops/web",
    "dev:mobile": "npm start -w @field-ops/mobile",
    "test": "npm test -w @field-ops/api"
  },
  "devDependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=20.9"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "react": "$react",
    "react-dom": "$react-dom",
    "uuid": "$uuid"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "fsevents": true
  }
}
