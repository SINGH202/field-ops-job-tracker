DATABASE_URL=postgres://fieldops:fieldops@localhost:5433/fieldops
TEST_DATABASE_URL=postgres://fieldops:fieldops@localhost:5433/fieldops_test
PORT=3001
# Next.js `/backend` rewrite. Repo-root `.env` (restart `npm run dev:web` after changing).
# Local API: http://127.0.0.1:3001  Hosted: https://your-api.onrender.com
API_PROXY_TARGET=http://127.0.0.1:3001
NEXT_PUBLIC_API_URL=/backend
# Android emulator → host. For a physical device, use http://<your-lan-ip>:3001
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001
